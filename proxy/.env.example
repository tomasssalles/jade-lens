# Copy to .env for local dev (gitignored). In prod these come from the platform
# (Cloud Run env vars / Secret Manager), never from a committed file.

# Shared bearer token the web app presents on every request.
PROXY_TOKEN=dev-token-change-me

# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# GitHub PAT injected server-side on /gh forwards (never sent to the browser).
GITHUB_PAT=github_pat_xxx

# The single data repo the /gh route is scoped to, as owner/repo.
DATA_REPO=owner/repo
