{
  "name": "json_patch output is JS-canonical: integer-valued floats and raw UTF-8",
  "description": "Pins the cross-client byte-identity contract (README §3–§4): the re-serialised .json file matches JSON.stringify(obj, null, 2) + newline. An integer-valued float added by the patch (2.0) is written as 2 (a JS client loses the .0 on JSON.parse), and a non-ASCII string value is emitted raw, not \\uXXXX-escaped. A genuine fraction (0.25) is preserved.",
  "before": {
    "config.json": "{\n  \"count\": 1\n}\n",
    "Index.json": "[\n  {\n    \"File\": \"[[config.json]]\",\n    \"Scope\": \"Config\"\n  }\n]\n"
  },
  "commit_message": "Record ratio and label",
  "operations": [
    { "op": "json_patch", "path": "config.json", "patch": [
      { "op": "add", "path": "/ratio", "value": 2.0 },
      { "op": "add", "path": "/threshold", "value": 0.25 },
      { "op": "add", "path": "/label", "value": "café ☕" }
    ] }
  ],
  "expect": {
    "after": {
      "config.json": "{\n  \"count\": 1,\n  \"ratio\": 2,\n  \"threshold\": 0.25,\n  \"label\": \"café ☕\"\n}\n",
      "Index.json": "[\n  {\n    \"File\": \"[[config.json]]\",\n    \"Scope\": \"Config\"\n  }\n]\n",
      ".jade/operations-log/v1.jsonl": "{\"ts\":\"<TS>\",\"commit_message\":\"Record ratio and label\",\"operations\":[{\"op\":\"json_patch\",\"path\":\"config.json\",\"patch\":[{\"op\":\"add\",\"path\":\"/ratio\",\"value\":2},{\"op\":\"add\",\"path\":\"/threshold\",\"value\":0.25},{\"op\":\"add\",\"path\":\"/label\",\"value\":\"café ☕\"}]}]}\n"
    }
  }
}
