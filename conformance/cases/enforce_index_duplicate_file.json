{
  "name": "enforcement rejects Index.json with duplicate File entries",
  "before": {
    "notes.md": "# notes\n",
    "Index.json": "[\n  {\n    \"File\": \"[[notes.md]]\",\n    \"Scope\": \"Notes\"\n  },\n  {\n    \"File\": \"[[notes.md]]\",\n    \"Scope\": \"Duplicate\"\n  }\n]\n"
  },
  "commit_message": "Patch data",
  "operations": [
    { "op": "unified_diff", "path": "notes.md", "diff": "@@ -1 +1 @@\n-# notes\n+# updated notes\n" }
  ],
  "expect": { "error": "INDEX_DUPLICATE_FILE" }
}
