{
  "name": "json_patch array append with multi-block string promotes using resolved index",
  "description": "When a json_patch add uses /- (array append) and the value is promotable, the runtime resolves /- to a concrete index (using the current array length) before deriving the sidecar path.",
  "before": {
    "Projects.json": "{\"items\": []}\n",
    "Index.json": "[\n  {\n    \"File\": \"[[Projects.json]]\",\n    \"Scope\": \"Projects\"\n  }\n]\n"
  },
  "commit_message": "Add item",
  "operations": [
    {
      "op": "json_patch",
      "path": "Projects.json",
      "patch": [
        {
          "op": "add",
          "path": "/items/-",
          "value": "Step one.\n\nStep two.\n"
        }
      ]
    }
  ],
  "expect": {
    "after": {
      "Projects.json": "{\n  \"items\": [\n    \"[[Projects.sidecars/items/0.md]]\"\n  ]\n}\n",
      "Projects.sidecars/items/0.md": "Step one.\n\nStep two.\n",
      "Index.json": "[\n  {\n    \"File\": \"[[Projects.json]]\",\n    \"Scope\": \"Projects\"\n  }\n]\n",
      ".jade/operations-log/v1.jsonl": "{\"ts\": \"<TS>\", \"commit_message\": \"Add item\", \"operations\": [{\"op\": \"json_patch\", \"path\": \"Projects.json\", \"patch\": [{\"op\": \"add\", \"path\": \"/items/-\", \"value\": \"Step one.\\n\\nStep two.\\n\"}]}]}\n"
    }
  }
}
