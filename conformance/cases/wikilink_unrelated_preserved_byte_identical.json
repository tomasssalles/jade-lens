{
  "name": "non-matching wikilinks are preserved byte-identical on rewrite",
  "description": "In a file with both a matching and a non-matching wikilink, only the matching one is rewritten. The non-matching link is returned byte-identical even when denormalised ([[./unrelated.md]]) — normalisation happens only as a side effect of an actual rewrite, never on links left alone (DESIGN §4.3).",
  "before": {
    "old.md": "# original\n",
    "unrelated.md": "# unrelated\n",
    "ref.md": "see [[old.md]] and [[./unrelated.md]]\n",
    "Index.json": "[\n  {\n    \"File\": \"[[old.md]]\",\n    \"Scope\": \"original\"\n  },\n  {\n    \"File\": \"[[unrelated.md]]\",\n    \"Scope\": \"unrelated\"\n  },\n  {\n    \"File\": \"[[ref.md]]\",\n    \"Scope\": \"reference\"\n  }\n]\n"
  },
  "commit_message": "Rename preserving unrelated links",
  "operations": [
    { "op": "rename_path", "from": "old.md", "to": "new.md" }
  ],
  "expect": {
    "after": {
      "new.md": "# original\n",
      "unrelated.md": "# unrelated\n",
      "ref.md": "see [[new.md]] and [[./unrelated.md]]\n",
      "Index.json": "[\n  {\n    \"File\": \"[[new.md]]\",\n    \"Scope\": \"original\"\n  },\n  {\n    \"File\": \"[[unrelated.md]]\",\n    \"Scope\": \"unrelated\"\n  },\n  {\n    \"File\": \"[[ref.md]]\",\n    \"Scope\": \"reference\"\n  }\n]\n",
      ".jade/operations-log/v1.jsonl": "{\"ts\": \"<TS>\", \"commit_message\": \"Rename preserving unrelated links\", \"operations\": [{\"op\": \"rename_path\", \"from\": \"old.md\", \"to\": \"new.md\"}]}\n"
    }
  }
}
