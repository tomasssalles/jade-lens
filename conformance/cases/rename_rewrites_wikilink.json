{
  "name": "rename_path rewrites wikilinks in referencing files",
  "description": "Renaming a markdown file rewrites every [[old]] wikilink pointing at it (here, inside a JSON string value) to [[new]] via the post-apply pass, textually preserving the referencing file's formatting. One operations-log entry is appended.",
  "before": {
    "Projects/Leasing.json": "{\n  \"notes\": \"[[Projects/old.md]]\"\n}\n",
    "Projects/old.md": "# Old notes\n",
    "Index.json": "[\n  {\n    \"File\": \"[[Projects/Leasing.json]]\",\n    \"Scope\": \"Leasing project\"\n  },\n  {\n    \"File\": \"[[Projects/old.md]]\",\n    \"Scope\": \"Old notes\"\n  }\n]\n"
  },
  "commit_message": "Rename old notes to new notes",
  "operations": [
    { "op": "rename_path", "from": "Projects/old.md", "to": "Projects/new.md" }
  ],
  "expect": {
    "after": {
      "Projects/Leasing.json": "{\n  \"notes\": \"[[Projects/new.md]]\"\n}\n",
      "Projects/new.md": "# Old notes\n",
      "Index.json": "[\n  {\n    \"File\": \"[[Projects/Leasing.json]]\",\n    \"Scope\": \"Leasing project\"\n  },\n  {\n    \"File\": \"[[Projects/new.md]]\",\n    \"Scope\": \"Old notes\"\n  }\n]\n",
      ".jade/operations-log/v1.jsonl": "{\"ts\": \"<TS>\", \"commit_message\": \"Rename old notes to new notes\", \"operations\": [{\"op\": \"rename_path\", \"from\": \"Projects/old.md\", \"to\": \"Projects/new.md\"}]}\n"
    }
  }
}
