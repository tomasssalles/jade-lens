{
  "name": "rename rewrites a file's wikilink to itself",
  "description": "A file containing a wikilink to itself has that self-reference rewritten too: after the rename, the moved file's self-link points at its new location.",
  "before": {
    "old.md": "I am [[old.md]] looking at myself\n",
    "Index.json": "[\n  {\n    \"File\": \"[[old.md]]\",\n    \"Scope\": \"self-referencing note\"\n  }\n]\n"
  },
  "commit_message": "Rename with self-reference",
  "operations": [
    { "op": "rename_path", "from": "old.md", "to": "new.md" }
  ],
  "expect": {
    "after": {
      "new.md": "I am [[new.md]] looking at myself\n",
      "Index.json": "[\n  {\n    \"File\": \"[[new.md]]\",\n    \"Scope\": \"self-referencing note\"\n  }\n]\n",
      ".jade/operations-log/v2.jsonl": "{\"ts\": \"<TS>\", \"commit_message\": \"Rename with self-reference\", \"operations\": [{\"op\": \"rename_path\", \"from\": \"old.md\", \"to\": \"new.md\"}]}\n"
    }
  }
}
