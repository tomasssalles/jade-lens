{
  "name": "delete_path removes a directory and all its contents",
  "description": "delete_path is recursive: deleting a directory removes every file beneath it. Only the operations-log entry and an empty index remain.",
  "before": {
    "archive/old1.md": "# one\n",
    "archive/sub/old2.md": "# two\n",
    "Index.json": "[\n  {\n    \"File\": \"[[archive/old1.md]]\",\n    \"Scope\": \"Old file 1\"\n  },\n  {\n    \"File\": \"[[archive/sub/old2.md]]\",\n    \"Scope\": \"Old file 2\"\n  }\n]\n"
  },
  "commit_message": "Remove archive directory",
  "operations": [
    { "op": "delete_path", "path": "archive" },
    { "op": "json_patch", "path": "Index.json", "patch": [{ "op": "remove", "path": "/0" }, { "op": "remove", "path": "/0" }] }
  ],
  "expect": {
    "after": {
      "Index.json": "[]\n",
      ".jade/operations-log/v1.jsonl": "{\"ts\": \"<TS>\", \"commit_message\": \"Remove archive directory\", \"operations\": [{\"op\": \"delete_path\", \"path\": \"archive\"}, {\"op\": \"json_patch\", \"path\": \"Index.json\", \"patch\": [{\"op\": \"remove\", \"path\": \"/0\"}, {\"op\": \"remove\", \"path\": \"/0\"}]}]}\n"
    }
  }
}
