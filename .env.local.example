# Copy this file to .env.local and fill in real values.
# Used by tests/e2e/materialize.py (--github mode) and the web app dev server.
# Never commit .env.local.
#
# The GitHub test repo must already exist and its name must match
# jade-lens-test(-.+)? (e.g. jade-lens-test or jade-lens-test-2).
# The PAT should be fine-grained, scoped only to that repo, with Contents: read/write.

VITE_JL_E2E_REPO_URL=https://github.com/<owner>/jade-lens-test
VITE_JL_E2E_PAT=ghp_xxxxxxxxxxxxxxxxxxxx

# Secrets-proxy migration flag (Phase 1). When VITE_PROXY_URL is set, the web app
# routes all GitHub calls through the proxy and authenticates with the proxy
# token instead of the PAT. Leave unset for the direct-to-GitHub behavior.
# VITE_PROXY_URL=https://jadelens-proxy-xxxx.a.run.app
# VITE_PROXY_TOKEN=dev-token-change-me
