{
  "name": "directory rename rewrites deeply-nested wikilink prefixes",
  "description": "Renaming a directory swaps the directory prefix in every wikilink pointing under it, preserving the remaining sub-path. Files under the directory move too.",
  "before": {
    "ref.md": "see [[projects/leasing/notes.md]] and [[projects/leasing/cars.json]]\n",
    "projects/leasing/notes.md": "# notes\n",
    "projects/leasing/cars.json": "{}\n",
    "Index.json": "[\n  {\n    \"File\": \"[[ref.md]]\",\n    \"Scope\": \"reference\"\n  },\n  {\n    \"File\": \"[[projects/leasing/notes.md]]\",\n    \"Scope\": \"notes\"\n  },\n  {\n    \"File\": \"[[projects/leasing/cars.json]]\",\n    \"Scope\": \"cars\"\n  }\n]\n"
  },
  "commit_message": "Rename projects dir to archive",
  "operations": [
    { "op": "rename_path", "from": "projects", "to": "archive" }
  ],
  "expect": {
    "after": {
      "ref.md": "see [[archive/leasing/notes.md]] and [[archive/leasing/cars.json]]\n",
      "archive/leasing/notes.md": "# notes\n",
      "archive/leasing/cars.json": "{}\n",
      "Index.json": "[\n  {\n    \"File\": \"[[ref.md]]\",\n    \"Scope\": \"reference\"\n  },\n  {\n    \"File\": \"[[archive/leasing/notes.md]]\",\n    \"Scope\": \"notes\"\n  },\n  {\n    \"File\": \"[[archive/leasing/cars.json]]\",\n    \"Scope\": \"cars\"\n  }\n]\n",
      ".jade/operations-log/v1.jsonl": "{\"ts\": \"<TS>\", \"commit_message\": \"Rename projects dir to archive\", \"operations\": [{\"op\": \"rename_path\", \"from\": \"projects\", \"to\": \"archive\"}]}\n"
    }
  }
}
